{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "floorplan-ai capture dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "$ref": "#/$defs/id"
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/property"
      }
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "enum": [
            "horizontal",
            "vertical",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "declared",
            "derived"
          ],
          "default": "declared"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "source_type",
        "file"
      ],
      "properties": {
        "capture_id": {
          "$ref": "#/$defs/id"
        },
        "source_type": {
          "enum": [
            "photo",
            "video"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "room_id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "captures"
      ],
      "properties": {
        "trial_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "captures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capture"
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "trials"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "room_id"
            ],
            "properties": {
              "room_id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trial"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground_truth_file",
        "format"
      ],
      "properties": {
        "ground_truth_file": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "xlsx",
            "json",
            "csv"
          ]
        }
      }
    }
  }
}
